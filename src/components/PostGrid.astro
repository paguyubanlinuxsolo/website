---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';

interface Props {
  heading: string;
  intro?: string;
  page: Page<CollectionEntry<'posts'>>;
}
const { heading, intro, page } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-10">
  <h1 class="font-display font-bold text-3xl sm:text-4xl flex items-center">
    <span class="brand-mark" aria-hidden="true"></span>{heading}
  </h1>
  {intro && <p class="mt-3 text-muted dark:text-muted-dark max-w-2xl">{intro}</p>}
  {
    page.data.length > 0 ? (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="mt-8 text-muted dark:text-muted-dark">
        Belum ada tulisan di sini. Lihat semua tulisan di <a href="/blog/" class="underline decoration-brand decoration-2 underline-offset-2">halaman blog</a>.
      </p>
    )
  }
  <Pagination page={page} />
</section>
