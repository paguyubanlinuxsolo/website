---
import Base from '../layouts/Base.astro';
import { SITE, url } from '../consts';

// Data dari halaman Pengurus situs lama (diperbarui 12 November 2023)
const U = '/images/uploads';
const pengurus = [
  { nama: 'Andreas Abi Permana', foto: `${U}/2023/12/pls-abi.jpg` },
  { nama: 'Hermanto Gito Soemarno', foto: `${U}/2023/12/pls-hermanto.jpg` },
  { nama: 'Afdul Fauzan', foto: `${U}/2023/12/20231219_214505_0000.png` },
  { nama: 'Arif Dermawan', foto: `${U}/2024/03/photo_2023-02-03_19-09-50.jpg` },
  { nama: 'Habib Abdurrasyid', foto: `${U}/2023/12/pls-habib.jpg` },
  { nama: 'Rhesa Prawedha', foto: `${U}/2023/12/pls-rhesaprawedha.jpg` },
  { nama: 'Praditya', foto: `${U}/2023/12/pls-praditya.jpg` },
  { nama: 'Rizky Surya Maulana', foto: `${U}/2023/12/pls-rizky.jpg` },
  { nama: 'Brian Purnama', foto: `${U}/2023/12/pls-brian.jpg` },
];
const donatur = ['Wisnu Sanjaya', 'Ananda Dwi R', 'Fajar Riandani', 'Anang'];
---

<Base title="Pengurus" description="Pengurus aktif dan donatur Paguyuban Linux Solo.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-display font-bold text-3xl sm:text-4xl flex items-center">
      <span class="brand-mark" aria-hidden="true"></span>Pengurus
    </h1>
    <p class="mt-3 text-muted dark:text-muted-dark">Pengurus aktif, diperbarui November 2023.</p>

    <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-8">
      {
        pengurus.map((p) => (
          <li class="text-center">
            <img
              src={url(p.foto)}
              alt={`Foto ${p.nama}`}
              width="240"
              height="240"
              loading="lazy"
              class="w-full max-w-36 mx-auto aspect-square object-cover rounded-md border-b-4 border-brand"
            />
            <span class="block mt-3 font-display font-bold leading-snug">{p.nama}</span>
          </li>
        ))
      }
    </ul>

    <section class="mt-14 max-w-2xl">
      <h2 class="font-display font-bold text-2xl flex items-center">
        <span class="brand-mark" aria-hidden="true"></span>Donatur
      </h2>
      <p class="mt-2 text-muted dark:text-muted-dark">Terima kasih kepada para donatur yang menghidupi komunitas ini.</p>
      <ul class="mt-4 grid sm:grid-cols-2 gap-1.5 list-disc list-inside">
        {donatur.map((d) => <li>{d}</li>)}
      </ul>
    </section>

    <section class="mt-14 bg-brand text-ink rounded-md p-6 sm:p-8 max-w-2xl">
      <h2 class="font-display font-bold text-2xl">Mau ikut mengurus atau jadi pemateri ?</h2>
      <p class="mt-2 font-medium">
        Kami selalu terbuka untuk volunteer dan pemateri, dari siapa saja.
      </p>
      <a
        href={SITE.contact.telegram.url}
        rel="noopener"
        class="inline-block mt-4 bg-ink text-paper font-bold px-5 py-2.5 rounded-sm hover:text-brand transition-colors"
      >
        Sapa kami di Telegram
      </a>
    </section>
  </div>
</Base>
