---
import Base from '../layouts/Base.astro';
---

<Base title="Cari" description="Cari artikel dan halaman di situs Paguyuban Linux Solo.">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display font-bold text-3xl sm:text-4xl flex items-center">
      <span class="brand-mark" aria-hidden="true"></span>Cari
    </h1>
    <p class="mt-3 text-muted dark:text-muted-dark">Cari tutorial, liputan kegiatan, atau halaman apa pun di situs ini.</p>

    <div id="search" class="mt-6"></div>
    <noscript>
      <p class="mt-4">
        Pencarian membutuhkan JavaScript. Sebagai alternatif, jelajahi
        <a href="/blog/" class="underline decoration-brand decoration-2 underline-offset-2">arsip blog</a>.
      </p>
    </noscript>
  </div>
</Base>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        translations: {
          placeholder: 'Ketik kata kunci…',
          zero_results: 'Tidak ada hasil untuk "[SEARCH_TERM]". Coba kata kunci lain.',
          clear_search: 'Bersihkan',
          load_more: 'Muat hasil lainnya',
          search_label: 'Cari di situs ini',
          searching: 'Mencari "[SEARCH_TERM]"…',
        },
      });
      const input = document.querySelector('#search input');
      if (input) input.focus();
    } else {
      // index Pagefind belum ada (mis. saat `npm run dev` sebelum build pertama)
      document.getElementById('search').innerHTML =
        '<p>Index pencarian belum tersedia. Jalankan <code>npm run build</code> sekali agar index dibuat, lalu muat ulang halaman ini.</p>';
    }
  });
</script>

<style is:global>
  /* selaraskan Pagefind UI dengan tema situs */
  #search {
    --pagefind-ui-primary: var(--color-bark);
    --pagefind-ui-text: var(--color-body);
    --pagefind-ui-background: var(--color-paper);
    --pagefind-ui-border: color-mix(in srgb, var(--color-ink) 20%, transparent);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-font: inherit;
  }
  .dark #search {
    --pagefind-ui-primary: var(--color-brand);
    --pagefind-ui-text: var(--color-body-dark);
    --pagefind-ui-background: var(--color-ink-soft);
    --pagefind-ui-border: color-mix(in srgb, var(--color-paper) 20%, transparent);
  }
</style>
