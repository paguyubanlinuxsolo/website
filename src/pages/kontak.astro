---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

const channels = [
  { ...SITE.contact.telegram, name: 'Telegram', note: 'Grup diskusi utama. Tanya apa saja seputar GNU/Linux di sini.' },
  { ...SITE.contact.whatsapp, name: 'WhatsApp', note: 'Kontak langsung pengurus.' },
  { ...SITE.contact.instagram, name: 'Instagram', note: 'Pengumuman kegiatan dan dokumentasi.' },
  { ...SITE.contact.github, name: 'GitHub', note: 'Proyek dan kontribusi komunitas.' },
  { ...SITE.contact.linkedin, name: 'LinkedIn', note: 'Jejaring profesional komunitas.' },
];
---

<Base title="Kontak" description="Hubungi Paguyuban Linux Solo lewat Telegram, WhatsApp, Instagram, GitHub, atau LinkedIn.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-display font-bold text-3xl sm:text-4xl flex items-center">
      <span class="brand-mark" aria-hidden="true"></span>Kontak
    </h1>
    <p class="mt-4 max-w-2xl">
      Paling cepat lewat grup Telegram : semua anggota bisa saling bantu di sana. Kanal lain tetap kami pantau.
    </p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 max-w-4xl">
      {
        channels.map((c) => (
          <li>
            <a
              href={c.url}
              rel="noopener"
              class="block border border-ink/15 dark:border-paper/15 rounded-md p-5 h-full hover:border-brand transition-colors"
            >
              <span class="font-display font-bold text-lg">{c.name}</span>
              <span class="block text-muted dark:text-muted-dark mt-1">{c.note}</span>
              <span class="block mt-3 underline decoration-brand decoration-2 underline-offset-4 break-all">{c.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="mt-12 max-w-4xl">
      <h2 class="font-display font-bold text-2xl flex items-center">
        <span class="brand-mark" aria-hidden="true"></span>Basecamp
      </h2>
      <p class="mt-3 text-muted dark:text-muted-dark">Wilayah kegiatan kami : Solo Raya dan sekitarnya.</p>
      <iframe
        src="https://www.google.com/maps?q=Surakarta&output=embed"
        title="Peta wilayah Solo Raya"
        class="mt-4 w-full h-80 rounded-md border border-ink/15 dark:border-paper/15"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
  </div>
</Base>
