---
import Base from '../layouts/Base.astro';
import { url } from '../consts';
---

<Base title="Halaman tidak ditemukan">
  <div class="mx-auto max-w-6xl px-4 py-24 text-center">
    <p class="font-display font-bold text-7xl sm:text-8xl">
      4<span class="bg-brand text-ink px-2">0</span>4
    </p>
    <h1 class="font-display font-bold text-2xl mt-6">Halaman tidak ditemukan</h1>
    <p class="mt-3 text-muted dark:text-muted-dark max-w-md mx-auto">
      Tautan yang kamu buka mungkin sudah pindah saat situs ini bermigrasi, atau memang tidak pernah ada.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={url('/')} class="bg-brand text-ink font-bold px-6 py-3 rounded-sm hover:opacity-90">Ke beranda</a>
      <a href={url('/cari/')} class="border-2 border-ink/30 dark:border-paper/30 font-bold px-6 py-3 rounded-sm hover:border-brand">Cari artikel</a>
    </div>
  </div>
</Base>
